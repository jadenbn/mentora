# Required
GEMINI_API_KEY=

# Optional tutor tuning
# A lite model is ~7x faster on a canvas request and the tutor's job is
# small; see scripts/bench_tutor.py.
GEMINI_MODEL=gemini-3.5-flash-lite
TUTOR_REQUEST_TIMEOUT_SECONDS=45

# Course ingestion and large-document retrieval
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=course-context

# Small documents at or below this serialized context size bypass retrieval.
QUESTION_FULL_CONTEXT_MAX_CHARS=40000

# Optional path for course documents and grounded generated problems.
MENTORA_DB_PATH=mentora.db

# Origins allowed to call this API. Add your machine's address to reach the
# backend from a phone or tablet, e.g.
#   CORS_ALLOW_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Shared secret required on /api and /dev requests. Leave unset for local
# development; set it on any deployment reachable by anything but you -- this
# API spends provider quota and writes student mastery. It authenticates the
# caller, not the student: student_id is still whatever the request says.
MENTORA_API_KEY=
