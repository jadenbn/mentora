# Required
GEMINI_API_KEY=

# Optional tutor tuning
# A lite model is ~7x faster on a canvas request and the tutor's job is
# small; see scripts/bench_tutor.py.
GEMINI_MODEL=gemini-3.5-flash-lite
# Supported values: minimal, low, medium, high. Some models reject minimal.
GEMINI_THINKING_LEVEL=low
TUTOR_REQUEST_TIMEOUT_SECONDS=45
# Debug only: logs prompts and course/student context to the backend console.
# Keep disabled outside local development.
TUTOR_DEBUG_LOG_REQUESTS=0

# Optional voice tuning. Speech-to-text reuses GEMINI_API_KEY, so voice needs
# no extra credential. The dedicated transcription model does one job and takes
# no prompt, response schema, or thinking budget; a general multimodal model
# here would need all three back.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
VOICE_REQUEST_TIMEOUT_SECONDS=30

# Canonical course/problem store
MENTORA_DB_PATH=mentora.sqlite3
QUESTION_FULL_CONTEXT_MAX_CHARS=40000

# Course ingestion only. Not needed to run the tutor: course retrieval is
# deferred until the canvas loop is working end to end.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mentora

# Origins allowed to call this API. Add your machine's address to reach the
# backend from a phone or tablet, e.g.
#   CORS_ALLOW_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
