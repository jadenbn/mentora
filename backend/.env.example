# Required
GEMINI_API_KEY=

# Optional tutor tuning
GEMINI_MODEL=gemini-3.7-flash
TUTOR_REQUEST_TIMEOUT_SECONDS=45

# Optional path for course documents and grounded generated problems.
MENTORA_DB_PATH=mentora.db

# Origins allowed to call this API. Add your machine's address to reach the
# backend from a phone or tablet, e.g.
#   CORS_ALLOW_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
